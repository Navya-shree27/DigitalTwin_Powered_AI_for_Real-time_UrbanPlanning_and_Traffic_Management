# ─── LLM Settings ────────────────────────────────────────────────────────────
# LLM Provider options: "anthropic", "ollama"
LLM_PROVIDER=ollama

# If using local Ollama model (ensure Ollama is running):
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b  # Change this to the model you have downloaded, e.g., llama3.2:3b, llama3

# If using Anthropic instead:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# LLM_PROVIDER=anthropic

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default — no setup needed)
DATABASE_URL=sqlite:///./digital_twin.db

# PostgreSQL with PostGIS (Phase B+):
# DATABASE_URL=postgresql://user:password@localhost:5432/digital_twin_db

# ─── Target City Area ────────────────────────────────────────────────────────
# Place name (used by OSMnx to download road network)
CITY_PLACE_NAME=Davanagere, Karnataka, India

# OR use a custom bounding box (lat_min, lon_min, lat_max, lon_max):
# CITY_BBOX_NORTH=14.4900
# CITY_BBOX_SOUTH=14.4300
# CITY_BBOX_EAST=75.9500
# CITY_BBOX_WEST=75.9000

# ─── Simulation Settings ─────────────────────────────────────────────────────
# "synthetic" uses OSMnx graph to generate realistic synthetic telemetry
# "sumo" uses SUMO via TraCI (requires SUMO installed)
# "cityflow" uses CityFlow (requires CityFlow installed)
SIMULATION_ENGINE=synthetic

# Simulation time window in seconds (3600 = 1 hour)
SIMULATION_DURATION=3600

# Random seed for reproducibility
SIMULATION_SEED=42

# ─── Backend Settings ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
